#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <malloc.h>
#include <time.h>
#include <ctype.h>
#include <x86intrin.h>

int main() {

    uint64_t start = __rdtsc();
    // Code to measure
    for (volatile int i = 0; i < 1000000; i++);
    uint64_t end = __rdtsc();


    printf("Cycles: %lu\n", end - start);
    return 0;
}


int main1(int argc, char **args) {
    if (argc != 2) {
        printf("Usage %s <iteration>\n", args[0]);
        exit(EXIT_FAILURE);
    }

    u_int32_t i = atoi(args[1]);
    void *ptrs[i];

    // man mallopt max size on 64 bit machine is 4*1024*1024*sizeof(long)
    if (mallopt(M_MMAP_THRESHOLD, 4*1024*1024*sizeof(long)) == 0) {
        fprintf(stderr, "Failed to set M_MMAP_THRESHOLD\n");
        return 1;
    }

    // make it so small that no mmap is used (the -8 because the size must still be 8 byte aligned, will be rounded up to the next multiple of 8)
    size_t s = 2048; // 1024 * 1024 * 4 * sizeof(long) - 64;
    clock_t begin = clock();

    for (u_int32_t j = 0; j < i; ++j) {
        void *ptr = malloc(s);
        if (ptr == NULL) {
            perror("malloc failed");
            return 1;
        }
        ptrs[j] = ptr;
    }

    clock_t end = clock();
    double time_spent = (double)(end - begin) / CLOCKS_PER_SEC;

    printf("Start Allocated memory at %p\n", ptrs[0]);
    printf("Mid Allocated memory at %p\n", ptrs[i / 2]);
    printf("End. Allocated memory at %p\n", ptrs[i - 1]);

    printf("Time %f\n", time_spent);

    for (u_int32_t j = 0; j < i; ++j) {
        free(ptrs[j]);
    }

    return 0;
}
